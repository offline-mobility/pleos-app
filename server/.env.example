# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올라가지 않는다.

# 재난안전데이터공유플랫폼(safetydata.go.kr) 서비스 키. API마다 키가 다르다.
SAFETYDATA_ALERT_KEY=
SAFETYDATA_SHELTER_KEY=
# 민방위대피소 키는 서버 실행에는 필요 없고, data/civil-shelters.json을 새로 받을 때만 쓴다(npm run update-civil-shelters).
SAFETYDATA_CIVIL_SHELTER_KEY=

# 구조 상황판(/)에서 구조 요청 전체를 볼 때 쓰는 토큰. 비어 있으면 상황판 조회가 꺼진다.
# 만들기: openssl rand -hex 32
DASHBOARD_TOKEN=

# 저장소. 비어 있으면 메모리에만 저장한다(로컬 개발용, 재시작하면 사라짐).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1이면 키가 없을 때 견본 재난문자·대피소를 돌려준다. 로컬 개발·시연 전용. 실서비스에서는 켜지 않는다.
SAMPLE_DATA=
